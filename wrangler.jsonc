// Cloudflare Workers config for the AXIOR website (built with @opennextjs/cloudflare).
// `name` must match the Worker in the Cloudflare dashboard (Workers & Pages > axior-website).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "axior-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Lets the Worker call itself (used by OpenNext for caching/revalidation). Must equal `name`.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "axior-website"
    }
  ],
  // Shared with the admin console (Workers & Pages > D1 > axior-db): same database_id in both.
  // The website only reads the published keys (pricing, site, blog); see src/lib/published.ts.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "axior-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
